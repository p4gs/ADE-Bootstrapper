    {
      "id": "claim_c5bc4a3b89e4454ca6cb4be5a914dc30",
      "statement": "The gitignore withdrawal drops the labelled header and only the owned lines directly beneath it, stopping at the first line ADE does not own, so a user line inside the block survives.",
