  "claims": [
    {
      "id": "claim_30ebd4e4391c4733a4049a445f91d49f",
      "statement": "Removal is governed by one rule stated in the module header: never destroy what ADE cannot prove it wrote, so a hand-edited file, a block with no provenance line, and a file planted under the ADE-owned tree are each kept and reported rather than deleted.",
      "evidence": [
        {
          "resource": "repo://crates/ade-core/src/remove.rs#L9-L15",
          "version": "repo-lines-v1:sha256:cedba4a6d1281d0f403f845bed2404a721dc9c4b1d2acdc03b60af97410158ad:"
        }
      ]
    },
    {
      "id": "claim_0cc45bcb42a4407bbe966ee559052fcc",
      "statement": "Removal is lockfile-driven rather than path-driven: each locked path is deleted only when its current hash still equals the recorded one, and a mismatch becomes a kept file explained as edited since ADE wrote it.",
      "evidence": [
        {
          "resource": "repo://crates/ade-core/src/remove.rs#L209-L246",
          "version": "repo-lines-v1:sha256:6dec0d2dbfb3a25cd0f19efe81b37c386ab2ce449a33f2b9e86d247f705ff707:"
        }
      ]
    },
    {
      "id": "claim_decd11b1dce0472681d3a7f1438e1179",
      "statement": "With no lockfile nothing under the ADE-owned tree is deleted at all, because without it ADE cannot prove which files are its own.",
      "evidence": [
        {
          "resource": "repo://crates/ade-core/src/remove.rs#L239-L246",
          "version": "repo-lines-v1:sha256:2c917d0d46538e1b7947710063f7a4e92f4beaeb20cbd0f0d86d57aee04dd287:"
        }
      ]
    },
    {
      "id": "claim_023366b402cd413da3f882353b3f6962",
      "statement": "Plan and execute are the same pass: the plan computes a mutation per path with zero writes and the executing call replays exactly those mutations, so the real run is the dry run plus execution rather than a second differently-informed pass over a changed tree.",
      "evidence": [
        {
          "resource": "repo://crates/ade-core/src/remove.rs#L166-L180",
          "version": "repo-lines-v1:sha256:7f5b1a82e89ecd3d2092ad89c1e831cc34a6d57a7ff7bf590065f5cba0c36844:"
        }
      ]
    },
    {
      "id": "claim_33efbb3736de4d6faff9dc439a94a86c",
      "statement": "The user-owned local instructions file is deleted only when byte-identical to the untouched stub; otherwise ADE created the file but the words are the user's.",
