        }
      ]
    },
    {
      "id": "claim_d25ed938202c42e98fb6284b6c207539",
      "statement": "The serialization contract is byte-level: keys recursively sorted, two-space indent, a colon-space separator, empty containers as brackets, and a trailing newline, matching the oracle's JSON.stringify output.",
