    {
      "id": "claim_0b96902af6e74fcdaab7c22b833fe7fe",
      "statement": "stable_stringify hand-rolls key sorting and layout rather than relying on serde_json map ordering, because enabling the preserve_order feature anywhere in the workspace would silently break determinism everywhere.",
