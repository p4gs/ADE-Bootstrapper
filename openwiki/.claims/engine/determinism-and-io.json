        {
          "resource": "repo://crates/ade-core/src/fsutil.rs#L13-L23",
          "version": "repo-lines-v1:sha256:d24ab6b70cb4f65a9a108c0fd194e0f47ab73553dbb92d3125c6973be85c9fcc:"
        }
      ]
    },
    {
