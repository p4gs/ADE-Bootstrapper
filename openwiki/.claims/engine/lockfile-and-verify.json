        }
      ]
    },
    {
      "id": "claim_a739ec2fb6964f9eb3ceaa689c3ee748",
      "statement": "Scope is therefore path-derived rather than authorship-derived, so files ADE writes outside .ade/ receive no hash coverage at all.",
