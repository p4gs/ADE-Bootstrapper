    {
      "id": "claim_7ba26a01f2e646beb755907e42032151",
      "statement": "Lockfile scope is defined by scanning the ADE-owned tree rather than by the modules' reported written paths: everything under .ade/ recursively, minus the audit directory, sorted.",
      "evidence": [
        {
          "resource": "repo://crates/ade-core/src/lockfile.rs#L87-L113",
