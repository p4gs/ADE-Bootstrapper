    {
      "id": "claim_6c29a0179ce444b49274daa24b3ca889",
      "statement": "Verified without a checkpoint the chain detects only in-place tampering, reporting a previous-hash mismatch when an entry is deleted or reordered and a hash mismatch when a field is modified.",
