        }
      ]
    },
    {
      "id": "claim_1f44cd7f42ee4c80a4c1b90656cb885f",
      "statement": "The audit checkpoint recording length and head hash lives in the git-committed lockfile, outside the log it protects, which is what upgrades detection to cover truncation, tail-drop and a chain re-forged from genesis.",
      "evidence": [
        {
          "resource": "repo://crates/ade-core/src/audit.rs#L102-L127",
